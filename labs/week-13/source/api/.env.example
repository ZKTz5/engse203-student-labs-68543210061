NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ⭐⭐ Challenge Turso — เว้นว่างไว้ = ใช้ campus.db ในเครื่อง
# ค่าจริงใส่ใน .env (ห้าม commit) หรือใน Environment ของ Render
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=


# api/.env.example — เพิ่มท้ายไฟล์ (ชื่อตัวแปร ค่าว่าง · commit ได้)
# Week 13 — secret สำหรับเซ็น JWT
#   dev: เว้นว่างได้ (ใช้ค่าสำหรับพัฒนา) · production: ต้องตั้ง ไม่งั้นระบบไม่ยอม start
#   สร้างค่าสุ่ม: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=